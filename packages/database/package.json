{
  "name": "@dayos/database",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "./schema": { "types": "./dist/schema.d.ts", "default": "./dist/schema.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:verify": "tsx src/verify.ts"
  },
  "dependencies": { "drizzle-orm": "^0.44.5", "postgres": "^3.4.7" },
  "devDependencies": { "dotenv": "^17.2.2", "drizzle-kit": "^0.31.4", "tsx": "^4.20.5" }
}
