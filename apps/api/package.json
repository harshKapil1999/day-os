{
  "name": "@dayos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@clerk/backend": "^2.16.0",
    "@dayos/contracts": "workspace:*",
    "@dayos/database": "workspace:*",
    "@dayos/domain": "workspace:*",
    "@dayos/planner": "workspace:*",
    "@dayos/utils": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
